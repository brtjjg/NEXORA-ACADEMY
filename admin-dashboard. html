    <!-- ==========================================
    TOAST CONTAINER
    ========================================== -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- ==========================================
    JAVASCRIPT
    ========================================== -->
    <script>
        // ============================================
        // TOAST
        // ============================================
        function showToast(message, type = 'success', duration = 4000) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            const icons = { success: '✅', error: '❌', warning: '⚠️', info: 'ℹ️' };
            toast.innerHTML = `<span>${icons[type] || '📢'}</span> ${message}`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                setTimeout(() => toast.remove(), 400);
            }, duration);
        }

        // ============================================
        // SIDEBAR
        // ============================================
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.toggle('open');
            overlay.classList.toggle('active');
        }

        function closeSidebar() {
            document.getElementById('sidebar').classList.remove('open');
            document.getElementById('sidebarOverlay').classList.remove('active');
        }

        // ============================================
        // NAVIGATION
        // ============================================
        function navigateTo(page) {
            document.querySelectorAll('.sidebar .nav-item').forEach(item => {
                item.classList.remove('active');
            });

            // Find and activate the clicked item
            const items = document.querySelectorAll('.sidebar .nav-item');
            for (let item of items) {
                if (item.textContent.trim().toLowerCase().includes(page.replace('-', ' '))) {
                    item.classList.add('active');
                    break;
                }
            }

            const titles = {
                'dashboard': { title: '📊 Dashboard', subtitle: 'Welcome back! Here\'s what\'s happening today.' },
                'students': { title: '👥 Students', subtitle: 'Manage all student accounts and profiles.' },
                'courses': { title: '📚 Courses', subtitle: 'Create and manage all courses.' },
                'enrollments': { title: '📋 Enrollments', subtitle: 'View and manage student enrollments.' },
                'certificates': { title: '🎓 Certificates', subtitle: 'Generate and manage certificates.' },
                'payments': { title: '💰 Payments', subtitle: 'Track and manage all payments.' },
                'tutors': { title: '👨‍🏫 Tutors', subtitle: 'Manage tutor accounts and assignments.' },
                'live-classes': { title: '🎥 Live Classes', subtitle: 'Schedule and manage live classes.' },
                'admins': { title: '👑 Administrators', subtitle: 'Manage admin accounts and permissions.' },
                'reports': { title: '📊 Reports', subtitle: 'Generate and view reports.' },
                'settings': { title: '⚙️ Settings', subtitle: 'Configure platform settings.' },
                'activity-logs': { title: '📜 Activity Logs', subtitle: 'View all admin activities.' }
            };

            const info = titles[page] || titles['dashboard'];
            document.getElementById('pageTitle').textContent = info.title;
            document.getElementById('pageSubtitle').textContent = info.subtitle;

            closeSidebar();

            if (page !== 'dashboard') {
                showToast(`📄 Navigated to ${info.title}`, 'info', 2000);
            }
        }

        // ============================================
        // LOGOUT
        // ============================================
        function logout() {
            showToast('👋 Logging out...', 'info');
            localStorage.removeItem('nexora_admin');
            setTimeout(() => {
                window.location.href = 'admin-login.html';
            }, 1000);
        }

        // ============================================
        // LOAD ADMIN DATA
        // ============================================
        function loadAdminData() {
            const adminData = JSON.parse(localStorage.getItem('nexora_admin'));

            if (!adminData) {
                window.location.href = 'admin-login.html';
                return;
            }

            // Update sidebar with admin info
            const initials = adminData.name.split(' ').map(n => n[0]).join('').toUpperCase();
            document.getElementById('adminAvatar').textContent = initials;
            document.getElementById('adminName').textContent = adminData.name;
            document.getElementById('adminRole').textContent = adminData.role.replace('_', ' ').toUpperCase();

            // Check permissions
            const hasPermission = (permission) => {
                if (adminData.permissions.includes('all')) return true;
                return adminData.permissions.includes(permission);
            };

            // Show/hide menu items based on permissions
            const menuItems = {
                'students': true,
                'courses': hasPermission('courses') || hasPermission('all'),
                'enrollments': hasPermission('courses') || hasPermission('all'),
                'certificates': hasPermission('certificates') || hasPermission('all'),
                'payments': hasPermission('payments') || hasPermission('all'),
                'tutors': hasPermission('courses') || hasPermission('all'),
                'live-classes': hasPermission('courses') || hasPermission('all'),
                'admins': hasPermission('all'),
                'reports': hasPermission('all') || hasPermission('payments'),
                'settings': hasPermission('all'),
                'activity-logs': hasPermission('all')
            };

            document.querySelectorAll('.sidebar .nav-item').forEach(item => {
                const text = item.textContent.trim().toLowerCase();
                for (const [key, visible] of Object.entries(menuItems)) {
                    if (text.includes(key.replace('-', ' '))) {
                        if (!visible) item.style.display = 'none';
                        break;
                    }
                }
            });

            // Log activity
            logAdminActivity('view_dashboard', 'Admin viewed dashboard');
        }

        // ============================================
        // LOG ADMIN ACTIVITY
        // ============================================
        function logAdminActivity(action, details) {
            const logs = JSON.parse(localStorage.getItem('nexora_admin_logs') || '[]');
            const admin = JSON.parse(localStorage.getItem('nexora_admin'));
            logs.push({
                id: Date.now(),
                time: new Date().toISOString(),
                admin: admin ? admin.name : 'Unknown',
                role: admin ? admin.role : 'Unknown',
                action: action,
                details: details
            });

            // Keep only last 1000 logs
            if (logs.length > 1000) {
                logs.splice(0, logs.length - 1000);
            }

            localStorage.setItem('nexora_admin_logs', JSON.stringify(logs));
        }

        // ============================================
        // INIT
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            loadAdminData();

            // Log that admin dashboard was loaded
            logAdminActivity('dashboard_load', 'Admin dashboard loaded');

            // Close sidebar on outside click (mobile)
            document.addEventListener('click', function(e) {
                const sidebar = document.getElementById('sidebar');
                const toggle = document.getElementById('sidebarToggle');
                if (window.innerWidth <= 768 &&
                    !sidebar.contains(e.target) &&
                    !toggle.contains(e.target)) {
                    closeSidebar();
                }
            });
        });

        console.log('👑 Nexora Academy - Admin Dashboard');
        console.log('✅ Role-Based Access Control active');
        console.log('📝 All admin activities logged');
        console.log('🔒 2FA enabled');
    </script>

