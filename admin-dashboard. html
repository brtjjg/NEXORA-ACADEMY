<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
    <title>Admin Login - Nexora Academy</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"/>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        :root {
            --primary: #6C3CE1;
            --primary-dark: #5228b5;
            --secondary: #00d4aa;
            --dark: #1a1a2e;
            --dark-light: #2d2d44;
            --gray: #6b6b8a;
            --light-gray: #f0f0f7;
            --white: #ffffff;
            --danger: #e74c3c;
            --success: #2ecc71;
            --warning: #f39c12;
            --shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
            --radius: 16px;
        }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, var(--dark) 0%, var(--dark-light) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .login-container {
            width: 100%;
            max-width: 420px;
        }

        /* ============================================
           LOGO
           ============================================ */
        .logo {
            text-align: center;
            margin-bottom: 2rem;
        }

        .logo h1 {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--white);
        }

        .logo h1 i {
            color: var(--secondary);
        }

        .logo h1 span {
            color: var(--secondary);
        }

        .logo .tagline {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.85rem;
            margin-top: 0.2rem;
            letter-spacing: 2px;
        }

        .logo .admin-badge {
            display: inline-block;
            background: rgba(231, 76, 60, 0.2);
            color: var(--danger);
            padding: 2px 16px;
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-top: 0.3rem;
            border: 1px solid rgba(231, 76, 60, 0.3);
        }

        /* ============================================
           LOGIN CARD
           ============================================ */
        .login-card {
            background: var(--white);
            border-radius: var(--radius);
            padding: 2.5rem;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
        }

        .login-card .card-title {
            text-align: center;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 0.3rem;
        }

        .login-card .card-subtitle {
            text-align: center;
            color: var(--gray);
            font-size: 0.85rem;
            margin-bottom: 1.5rem;
        }

        /* ============================================
           FORM
           ============================================ */
        .form-group {
            margin-bottom: 1.2rem;
        }

        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.3rem;
            font-size: 0.85rem;
            color: var(--dark);
        }

        .form-group .input-wrapper {
            position: relative;
        }

        .form-group .input-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gray);
        }

        .form-group input {
            width: 100%;
            padding: 12px 14px 12px 44px;
            border: 2px solid var(--light-gray);
            border-radius: 10px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            background: var(--white);
        }

        .form-group input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(108, 60, 225, 0.1);
        }

        .form-group input.error {
            border-color: var(--danger);
            box-shadow: 0 0 0 4px rgba(231, 76, 60, 0.1);
        }

        .form-group .password-toggle {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: var(--gray);
            transition: all 0.3s ease;
        }

        .form-group .password-toggle:hover {
            color: var(--dark);
        }

        .error-message {
            color: var(--danger);
            font-size: 0.85rem;
            margin-top: 0.3rem;
            display: none;
            text-align: center;
            background: #fde8e8;
            padding: 0.5rem 1rem;
            border-radius: 8px;
        }

        .error-message.show {
            display: block;
        }

        /* ============================================
           BUTTONS
           ============================================ */
        .btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-primary {
            background: var(--primary);
            color: var(--white);
            margin-top: 0.5rem;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(108, 60, 225, 0.35);
        }

        .btn-primary:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none !important;
        }

        .btn-google {
            background: var(--white);
            color: var(--dark);
            border: 2px solid var(--light-gray);
            margin-top: 0.5rem;
        }

        .btn-google:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
        }

        .divider {
            text-align: center;
            margin: 1.2rem 0;
            position: relative;
        }

        .divider::before {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            top: 50%;
            height: 1px;
            background: var(--light-gray);
        }

        .divider span {
            background: var(--white);
            padding: 0 1rem;
            position: relative;
            color: var(--gray);
            font-size: 0.8rem;
        }

        .terms {
            text-align: center;
            font-size: 0.75rem;
            color: var(--gray);
            margin-top: 1.2rem;
        }

        .terms a {
            color: var(--primary);
            text-decoration: none;
        }

        .terms a:hover {
            text-decoration: underline;
        }

        /* ============================================
           2FA OVERLAY
           ============================================ */
        .twofa-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            z-index: 2000;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .twofa-overlay.active {
            display: flex;
        }

        .twofa-card {
            background: var(--white);
            border-radius: var(--radius);
            padding: 2.5rem;
            max-width: 400px;
            width: 100%;
            text-align: center;
            animation: slideUp 0.3s ease;
        }

        @keyframes slideUp {
            from {
                transform: translateY(30px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .twofa-card .icon {
            font-size: 3rem;
            color: var(--primary);
            margin-bottom: 1rem;
        }

        .twofa-card h3 {
            font-size: 1.2rem;
            margin-bottom: 0.3rem;
        }

        .twofa-card p {
            color: var(--gray);
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
        }

        .twofa-card .code-inputs {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            margin-bottom: 1.5rem;
        }

        .twofa-card .code-inputs input {
            width: 50px;
            height: 56px;
            text-align: center;
            font-size: 1.5rem;
            font-weight: 700;
            border: 2px solid var(--light-gray);
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .twofa-card .code-inputs input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(108, 60, 225, 0.1);
        }

        .twofa-card .resend {
            font-size: 0.85rem;
            color: var(--gray);
        }

        .twofa-card .resend a {
            color: var(--primary);
            cursor: pointer;
            text-decoration: none;
        }

        .twofa-card .resend a:hover {
            text-decoration: underline;
        }

        .twofa-card .btn {
            margin-top: 0.5rem;
        }

        .twofa-card .btn-outline {
            background: transparent;
            color: var(--primary);
            border: 2px solid var(--primary);
        }

        .twofa-card .btn-outline:hover {
            background: var(--primary);
            color: var(--white);
        }

        /* ============================================
           TOAST
           ============================================ */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 3000;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .toast {
            background: var(--dark);
            color: var(--white);
            padding: 14px 24px;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
            animation: slideIn 0.4s ease;
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 280px;
        }

        .toast.success {
            border-left: 4px solid var(--success);
        }
        .toast.error {
            border-left: 4px solid var(--danger);
        }
        .toast.warning {
            border-left: 4px solid var(--warning);
        }
        .toast.info {
            border-left: 4px solid var(--primary);
        }

        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* ============================================
           RESPONSIVE
           ============================================ */
        @media (max-width: 480px) {
            .login-card {
                padding: 1.5rem;
            }

            .logo h1 {
                font-size: 1.6rem;
            }

            .twofa-card {
                padding: 1.5rem;
            }

            .twofa-card .code-inputs input {
                width: 42px;
                height: 48px;
                font-size: 1.2rem;
            }
        }

        .hidden {
            display: none !important;
        }

        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        /* Security note at bottom */
        .security-note {
            text-align: center;
            margin-top: 1rem;
            color: rgba(255, 255, 255, 0.3);
            font-size: 0.7rem;
            letter-spacing: 1px;
        }

        .security-note i {
            margin-right: 0.3rem;
        }

        /* Back to main site link (hidden from regular users) */
        .back-link {
            text-align: center;
            margin-top: 1rem;
            color: rgba(255, 255, 255, 0.2);
            font-size: 0.7rem;
        }

        .back-link a {
            color: rgba(255, 255, 255, 0.3);
            text-decoration: none;
        }

        .back-link a:hover {
            color: rgba(255, 255, 255, 0.6);
        }
    </style>
</head>
<body>

    <!-- ==========================================
    2FA OVERLAY
    ========================================== -->
    <div class="twofa-overlay" id="twofaOverlay">
        <div class="twofa-card">
            <div class="icon"><i class="fas fa-shield-alt"></i></div>
            <h3>Two-Factor Authentication</h3>
            <p>Enter the 6-digit code sent to your email</p>
            <div class="code-inputs">
                <input type="text" maxlength="1" id="code1" oninput="moveNext(this, 'code2')" />
                <input type="text" maxlength="1" id="code2" oninput="moveNext(this, 'code3')" />
                <input type="text" maxlength="1" id="code3" oninput="moveNext(this, 'code4')" />
                <input type="text" maxlength="1" id="code4" oninput="moveNext(this, 'code5')" />
                <input type="text" maxlength="1" id="code5" oninput="moveNext(this, 'code6')" />
                <input type="text" maxlength="1" id="code6" oninput="verify2FA()" />
            </div>
            <div class="resend">
                Didn't receive code? <a onclick="resendCode()">Resend</a>
            </div>
            <button class="btn btn-primary" onclick="verify2FA()">
                <i class="fas fa-check"></i> Verify
            </button>
            <button class="btn btn-outline" style="margin-top:0.5rem;" onclick="cancel2FA()">
                <i class="fas fa-times"></i> Cancel
            </button>
        </div>
    </div>

    <!-- ==========================================
    TOAST CONTAINER
    ========================================== -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- ==========================================
    LOGIN FORM
    ========================================== -->
    <div class="login-container">
        <div class="logo">
            <h1><i class="fas fa-graduation-cap"></i> Nexora<span>Academy</span></h1>
            <div class="tagline">Learn. Build. Get Certified. Get Hired.</div>
            <div class="admin-badge"><i class="fas fa-shield-alt"></i> Admin Portal</div>
        </div>

        <div class="login-card">
            <div class="card-title">🔐 Admin Login</div>
            <div class="card-subtitle">Enter your credentials to access the admin panel</div>

            <!-- Login Form -->
            <form id="loginForm" onsubmit="handleLogin(event)">
                <div class="form-group">
                    <label>Email Address</label>
                    <div class="input-wrapper">
                        <i class="fas fa-envelope"></i>
                        <input type="email" id="adminEmail" placeholder="admin@nexoraacademy.com" value="admin@nexoraacademy.com" required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock"></i>
                        <input type="password" id="adminPassword" placeholder="Enter your password" value="Nexora@2026!Secure" required />
                        <span class="password-toggle" onclick="togglePassword()">
                            <i class="fas fa-eye" id="passwordIcon"></i>
                        </span>
                    </div>
                </div>

                <div class="error-message" id="loginError">
                    <i class="fas fa-exclamation-circle"></i> Invalid email or password. Please try again.
                </div>

                <button type="submit" class="btn btn-primary" id="loginBtn">
                    <i class="fas fa-sign-in-alt"></i> Login
                </button>
            </form>

            <div class="divider"><span>or continue with</span></div>

            <button class="btn btn-google" onclick="demoLogin()">
                <i class="fab fa-google"></i> Demo Login
            </button>

            <div class="terms">
                By continuing, you agree to our <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>
            </div>
        </div>

        <div class="security-note">
            <i class="fas fa-shield-alt"></i> Protected by Two-Factor Authentication
        </div>

        <div class="back-link">
            <a href="index.html">← Return to Main Site</a>
        </div>
    </div>

    <!-- ==========================================
    JAVASCRIPT
    ========================================== -->
    <script>
        // ============================================
        // ADMIN DATA (Hidden from regular users)
        // ============================================
        const ADMINS = [{
            id: 1,
            name: 'Super Admin',
            email: 'admin@nexoraacademy.com',
            username: 'superadmin',
            password: 'Nexora@2026!Secure',
            role: 'super_admin',
            permissions: ['all']
        }, {
            id: 2,
            name: 'Academic Admin',
            email: 'academic@nexoraacademy.com',
            username: 'academic',
            password: 'Academic@2026!',
            role: 'academic_admin',
            permissions: ['courses', 'modules', 'lessons', 'assignments', 'projects', 'tutors', 'live_classes',
                'certificates'
            ]
        }, {
            id: 3,
            name: 'Finance Admin',
            email: 'finance@nexoraacademy.com',
            username: 'finance',
            password: 'Finance@2026!',
            role: 'finance_admin',
            permissions: ['payments', 'fees', 'refunds', 'scholarships', 'reports']
        }, {
            id: 4,
            name: 'Certificate Admin',
            email: 'certificates@nexoraacademy.com',
            username: 'certificates',
            password: 'Cert@2026!Secure',
            role: 'certificate_admin',
            permissions: ['certificates', 'transcripts', 'qr_codes', 'verification', 'reissuance']
        }, {
            id: 5,
            name: 'Support Admin',
            email: 'support@nexoraacademy.com',
            username: 'support',
            password: 'Support@2026!',
            role: 'support_admin',
            permissions: ['support_tickets', 'password_reset', 'user_support']
        }];

        // ============================================
        // TOAST
        // ============================================
        function showToast(message, type = 'success', duration = 4000) {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            const icons = { success: '✅', error: '❌', warning: '⚠️', info: 'ℹ️' };
            toast.innerHTML = `<span>${icons[type] || '📢'}</span> ${message}`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                setTimeout(() => toast.remove(), 400);
            }, duration);
        }

        // ============================================
        // PASSWORD TOGGLE
        // ============================================
        function togglePassword() {
            const input = document.getElementById('adminPassword');
            const icon = document.getElementById('passwordIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye';
            }
        }

        // ============================================
        // 2FA INPUT HANDLING
        // ============================================
        function moveNext(current, nextId) {
            if (current.value.length === 1) {
                const next = document.getElementById(nextId);
                if (next) next.focus();
            }
        }

        // ============================================
        // RESEND 2FA CODE
        // ============================================
        function resendCode() {
            showToast('📧 New 2FA code sent to your email', 'info');
            // Auto-fill demo code
            const code = '123456';
            for (let i = 0; i < 6; i++) {
                const el = document.getElementById(`code${i+1}`);
                if (el) el.value = code[i];
            }
            showToast('📱 Demo code: 123456', 'info', 3000);
        }

        // ============================================
        // CANCEL 2FA
        // ============================================
        function cancel2FA() {
            document.getElementById('twofaOverlay').classList.remove('active');
            for (let i = 1; i <= 6; i++) {
                const el = document.getElementById(`code${i}`);
                if (el) el.value = '';
            }
            document.getElementById('loginBtn').disabled = false;
            document.getElementById('loginBtn').innerHTML = '<i class="fas fa-sign-in-alt"></i> Login';
        }

        // ============================================
        // VERIFY 2FA
        // ============================================
        function verify2FA() {
            let code = '';
            for (let i = 1; i <= 6; i++) {
                const el = document.getElementById(`code${i}`);
                if (el) code += el.value;
            }

            if (code.length !== 6) {
                showToast('Please enter the complete 6-digit code.', 'warning');
                return;
            }

            if (code.match(/^\d{6}$/)) {
                document.getElementById('twofaOverlay').classList.remove('active');
                showToast('✅ 2FA Verified! Redirecting to dashboard...', 'success');

                // Log activity
                logAdminActivity('login', 'Admin logged in successfully');

                setTimeout(() => {
                    window.location.href = 'admin-dashboard.html';
                }, 1500);
            } else {
                showToast('❌ Invalid code. Please try again.', 'error');
            }
        }

        // ============================================
        // LOGIN HANDLER
        // ============================================
        let failedAttempts = 0;
        let loginLocked = false;

        function handleLogin(e) {
            e.preventDefault();

            if (loginLocked) {
                showToast('🔒 Account temporarily locked. Please try again later.', 'error');
                return;
            }

            const email = document.getElementById('adminEmail').value.trim();
            const password = document.getElementById('adminPassword').value;
            const errorEl = document.getElementById('loginError');

            if (!email || !password) {
                errorEl.textContent = 'Please enter email and password.';
                errorEl.classList.add('show');
                return;
            }

            // Find admin
            const admin = ADMINS.find(a =>
                a.email === email ||
                a.username === email
            );

            if (!admin || admin.password !== password) {
                failedAttempts++;
                errorEl.textContent = `Invalid email or password. Attempt ${failedAttempts}/5`;
                errorEl.classList.add('show');

                // Highlight inputs
                document.getElementById('adminEmail').classList.add('error');
                document.getElementById('adminPassword').classList.add('error');

                if (failedAttempts >= 5) {
                    loginLocked = true;
                    errorEl.textContent = '🔒 Account locked due to multiple failed attempts. Please try again later.';
                    setTimeout(() => {
                        loginLocked = false;
                        failedAttempts = 0;
                        errorEl.classList.remove('show');
                        document.getElementById('adminEmail').classList.remove('error');
                        document.getElementById('adminPassword').classList.remove('error');
                    }, 300000);
                }
                return;
            }

            // Clear errors
            errorEl.classList.remove('show');
            document.getElementById('adminEmail').classList.remove('error');
            document.getElementById('adminPassword').classList.remove('error');

            // Successful login - proceed to 2FA
            showToast('✅ Credentials verified. Sending 2FA code...', 'success');

            document.getElementById('loginBtn').disabled = true;
            document.getElementById('loginBtn').innerHTML = '<span class="spinner"></span> Verifying...';

            // Send login notification
            sendLoginNotification(admin);

            setTimeout(() => {
                setTimeout(() => {
                    const demoCode = '123456';
                    for (let i = 0; i < 6; i++) {
                        const el = document.getElementById(`code${i+1}`);
                        if (el) el.value = demoCode[i];
                    }
                }, 500);

                document.getElementById('twofaOverlay').classList.add('active');
                document.getElementById('loginBtn').disabled = false;
                document.getElementById('loginBtn').innerHTML = '<i class="fas fa-sign-in-alt"></i> Login';

                showToast('📱 2FA code sent to your email (Demo: 123456)', 'info', 3000);
            }, 1500);

            // Store admin session
            localStorage.setItem('nexora_admin', JSON.stringify({
                id: admin.id,
                name: admin.name,
                email: admin.email,
                role: admin.role,
                permissions: admin.permissions,
                loginTime: new Date().toISOString()
            }));
        }

        // ============================================
        // DEMO LOGIN
        // ============================================
        function demoLogin() {
            document.getElementById('adminEmail').value = 'admin@nexoraacademy.com';
            document.getElementById('adminPassword').value = 'Nexora@2026!Secure';
            document.getElementById('loginError').classList.remove('show');
            document.getElementById('adminEmail').classList.remove('error');
            document.getElementById('adminPassword').classList.remove('error');

            // Auto-submit
            document.getElementById('loginForm').dispatchEvent(new Event('submit'));
        }

        // ============================================
        // SEND LOGIN NOTIFICATION
        // ============================================
        function sendLoginNotification(admin) {
            const device = navigator.userAgent.includes('Mobile') ? 'Mobile' : 'Desktop';
            const browser = navigator.userAgent.includes('Chrome') ? 'Chrome' :
                navigator.userAgent.includes('Firefox') ? 'Firefox' :
                navigator.userAgent.includes('Safari') ? 'Safari' : 'Unknown';

            const now = new Date();
            const dateStr = now.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            const timeStr = now.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit'
            });

            // Log notification (would send email in production)
            console.log(`📧 Login Notification Sent:
            Account: ${admin.email}
            Date: ${dateStr} at ${timeStr}
            Device: ${browser} on ${device}
            Location: Nairobi, Kenya (approximate)`);

            showToast('📧 Login notification sent to admin email', 'info', 3000);
        }

        // ============================================
        // LOG ADMIN ACTIVITY
        // ============================================
        function logAdminActivity(action, details) {
            const logs = JSON.parse(localStorage.getItem('nexora_admin_logs') || '[]');
            const admin = JSON.parse(localStorage.getItem('nexora_admin'));
            logs.push({
                id: Date.now(),
                time: new Date().toISOString(),
                admin: admin ? admin.name : 'System',
                action: action,
                details: details
            });
            localStorage.setItem('nexora_admin_logs', JSON.stringify(logs));
        }

        // ============================================
        // CHECK IF ALREADY LOGGED IN
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            const admin = JSON.parse(localStorage.getItem('nexora_admin'));
            if (admin) {
                // Redirect to dashboard if already logged in
                window.location.href = 'admin-dashboard.html';
            }

            // Auto-focus email field
            document.getElementById('adminEmail').focus();

            // Handle enter key on 2FA inputs
            document.querySelectorAll('.code-inputs input').forEach((input, index) => {
                input.addEventListener('keydown', function(e) {
                    if (e.key === 'Backspace' && this.value === '') {
                        const prev = document.getElementById(`code${index}`);
                        if (prev) prev.focus();
                    }
                });
            });

            // Remove error styling on input
            document.querySelectorAll('.form-group input').forEach(input => {
                input.addEventListener('input', function() {
                    this.classList.remove('error');
                    document.getElementById('loginError').classList.remove('show');
                });
            });
        });

        console.log('🔐 Nexora Academy - Admin Login System');
        console.log('👑 Super Admin: admin@nexoraacademy.com / Nexora@2026!Secure');
        console.log('📱 2FA Demo Code: 123456');
        console.log('✅ Admin panel is hidden from regular users');
    </script>

</body>
</html>
